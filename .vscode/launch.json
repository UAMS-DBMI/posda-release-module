{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Local: Debug full stack",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "sourceMapPathOverrides": {
                "/@fs/*": "${workspaceFolder}/*"
            },
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "Local:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}"
            }
        },
        {
            "name": "Prod: Debug full stack",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run preview:build",
            "sourceMapPathOverrides": {
                "/@fs/*": "${workspaceFolder}/*"
            },
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "Local:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}"
            }
        },
        {
            "name": "BookStack: sync manual (dry run)",
            "type": "node-terminal",
            "request": "launch",
            "command": "python scripts/sync_bookstack.py",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "BookStack: sync manual (apply)",
            "type": "node-terminal",
            "request": "launch",
            "command": "python scripts/sync_bookstack.py --apply",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Release ETL: prod (dry run)",
            "type": "node-terminal",
            "request": "launch",
            "command": "python scripts/etl/release_etl.py --input \"${input:etlInput}\" --env prod --dataset ${input:etlDataset}",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Release ETL: prod (apply)",
            "type": "node-terminal",
            "request": "launch",
            "command": "python scripts/etl/release_etl.py --input \"${input:etlInput}\" --env prod --dataset ${input:etlDataset} --apply --confirm-prod",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "etlInput",
            "type": "promptString",
            "description": "Release ETL input CSV",
            "default": ""
        },
        {
            "id": "etlDataset",
            "type": "promptString",
            "description": "WordPress page id of the dataset",
            "default": "44417"
        }
    ]
}