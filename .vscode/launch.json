{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Local: Debug full stack",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "sourceMapPathOverrides": {
                "/@fs/*": "${workspaceFolder}/*"
            },
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "Local:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}"
            }
        },
        {
            "name": "Prod: Debug full stack",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run build && npm run preview",
            "sourceMapPathOverrides": {
                "/@fs/*": "${workspaceFolder}/*"
            },
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "Local:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}"
            }
        },
        {
            "name": "BookStack: sync manual (dry run)",
            "type": "node-terminal",
            "request": "launch",
            "command": "python scripts/sync_bookstack.py",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "BookStack: sync manual (apply)",
            "type": "node-terminal",
            "request": "launch",
            "command": "python scripts/sync_bookstack.py --apply",
            "cwd": "${workspaceFolder}"
        }
    ]
}